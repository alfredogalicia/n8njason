        "jsCode": "return items.map(item => {\n  const originalText = item.json.output;\n\n  if (typeof originalText !== 'string') {\n    return {\n      json: {\n        error: 'El campo \"output\" no existe o no es un texto',\n        original: originalText\n      }\n    };\n  }\n\n  // 🔹 Limpieza básica conservando emojis\n  const cleaned = originalText\n    .replace(/<[^>]*>/g, '')   // elimina HTML\n    .replace(/\\n+/g, ' ')        // elimina saltos de línea\n    .replace(/\\t+/g, ' ')      // tabs → espacios\n    .replace(/[ ]{2,}/g, ' ') // espacios duplicados\n    .trim();\n\n  // 🔹 Un solo mensaje de salida\n  return {\n    json: {\n      output: cleaned\n    }\n  };\n});"
